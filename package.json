{
  "name": "painttrack",
  "description": "PaintTrack — 自托管 AI 图像、视频与工作流工作室",
  "homepage": "https://github.com/leafGGB/PaintTrack-AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leafGGB/PaintTrack-AI.git"
  },
  "private": true,
  "version": "2.0.0",
  "license": "MIT",
  "workspaces": [
    "packages/studio",
    "packages/Vibe-Workflow/packages/workflow-builder",
    "packages/Open-Poe-AI/packages/agents",
    "packages/Open-AI-Design-Agent/packages/design-agent"
  ],
  "scripts": {
    "dev": "node scripts/local-registration.js",
    "dev:mock": "node scripts/local-registration.js --mock --worker",
    "dev:controlled-image": "node scripts/local-registration.js --controlled-image",
    "build": "next build",
    "build:notrace": "node scripts/build-notrace.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test \"tests/*.test.js\"",
    "db:migrate": "node scripts/migrate.js",
    "admin:init": "node scripts/bootstrap-admin.js",
    "pricing:publish": "node scripts/publish-pricing.js",
    "credit:grant": "node scripts/grant-credit.js",
    "auth:cleanup": "node scripts/cleanup-auth-records.js",
    "auth:cleanup:test": "node scripts/cleanup-auth-records.js --apply",
    "db:migrate:check": "drizzle-kit check --config=drizzle.config.js",
    "test:db": "node --env-file=.env --test tests/databaseIntegration.test.js",
    "test:db:local": "node scripts/accept-database-local.js",
    "build:studio": "npm run build -w studio",
    "build:workflow": "npm run build -w workflow-builder",
    "build:agent": "npm run build -w ai-agent",
    "build:design": "npm run build -w design-agent",
    "build:packages": "npm run build:workflow && npm run build:agent && npm run build:design && npm run build:studio",
    "setup": "git submodule update --init --recursive && node scripts/apply-submodule-patches.js && npm install && npm run build:packages",
    "patch:submodules": "node scripts/apply-submodule-patches.js",
    "patch:submodules:check": "node scripts/apply-submodule-patches.js --check",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "electron:dev": "npm run vite:build && electron .",
    "electron:build": "vite build && electron-builder --mac",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:linux": "vite build && electron-builder --linux",
    "electron:build:linux:dir": "vite build && electron-builder --linux dir",
    "electron:build:linux:arm64:dir": "vite build && electron-builder --linux dir --arm64",
    "stage:local-ai": "node scripts/stage-local-ai-binary.js",
    "package:linux:deb": "node scripts/package-linux-deb.js",
    "package:linux:deb:arm64": "node scripts/package-linux-deb.js --arch arm64",
    "package:linux:deb:x64": "node scripts/package-linux-deb.js --arch x64",
    "electron:build:all": "vite build && electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "com.leafggb.painttrack",
    "productName": "PaintTrack",
    "copyright": "Copyright © 2025",
    "directories": {
      "output": "release"
    },
    "afterPack": "./afterPack.js",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build/local-ai",
        "to": "local-ai",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "public/banner.png",
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "public/banner.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "icon": "public/banner.png",
      "category": "Utility",
      "maintainer": "PaintTrack Team",
      "extraFiles": [
        {
          "from": "build/linux/apparmor.profile",
          "to": "resources/apparmor.profile"
        }
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "ai-agent": "file:./packages/Open-Poe-AI/packages/agents",
    "axios": "^1.7.0",
    "drizzle-orm": "^0.45.4",
    "konva": "^10.9.1",
    "next": "^15.0.0",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.4.1",
    "react-konva": "19.2.7",
    "studio": "*",
    "workflow-builder": "file:./packages/Vibe-Workflow/packages/workflow-builder",
    "xtend": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/vite": "^4.1.18",
    "autoprefixer": "^10.4.24",
    "drizzle-kit": "^0.31.11",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "vite": "^5.4.0"
  },
  "main": "electron/main.js",
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
