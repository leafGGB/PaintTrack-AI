# Local development defaults only. Do not put real credentials here.
NODE_ENV=development
PORT=3000
# 认证要求服务端配置精确源，不接受路径、查询参数或凭据。
# 生产必须HTTPS；不通过客户端转发头选择可信源。
APP_BASE_URL=http://localhost:3000
# 仅显式loopback开发允许HTTP Cookie不带Secure。
# production不接受此HTTP例外，配置错误安全失败。
AUTH_ALLOW_LOCAL_HTTP=1
# Local registration UI: run node scripts/local-registration.js (loopback-only).
# Optional launcher port, default 3211. Do not expose this development server.
# LOCAL_REGISTRATION_PORT=3212
# Mailbox capability and enable flags are generated privately by the launcher.
# Never copy them to .env, NEXT_PUBLIC variables or production configuration.
# Runtime identity for local development. Keep DDL privileges off this role.
DATABASE_URL=postgresql://painttrack:local-only@127.0.0.1:5433/painttrack_dev
# Dedicated migration identity for the same dev database; grant only required DDL.
MIGRATION_DATABASE_URL=postgresql://painttrack_migrator:local-only@127.0.0.1:5433/painttrack_dev
# One-time administrator bootstrap only; never pass this to Next.js or Worker.
# Must be a distinct least-privilege login on the same target. Use only with npm run admin:init.
# BOOTSTRAP_DATABASE_URL=postgresql://painttrack_bootstrap:local-only@127.0.0.1:5433/painttrack_dev
# Isolated integration-test database and its separate migration identity.
TEST_DATABASE_URL=postgresql://painttrack_test:local-only@127.0.0.1:5433/painttrack_test
TEST_MIGRATION_DATABASE_URL=postgresql://painttrack_test_migrator:local-only@127.0.0.1:5433/painttrack_test
# 仅由 npm run test:db:local 读取：用于新建一次性隔离库和角色，之后即不再使用。
# 必须是 loopback:5433 上的 postgres 管理库，且具备 CREATEDB/CREATEROLE；不得指向 dev/test/生产库。
# 密码中的特殊字符需百分号编码（例如 @ 写作 %40）。不配置时验收安全阻断，不会回退到上面的应用连接串。
# LOCAL_DATABASE_ADMIN_URL=postgresql://postgres:change-me@127.0.0.1:5433/postgres

# Admin MFA encryption key: required before enabling MFA HTTP routes; generate 32 random bytes as 64 hex chars.
# Server-side only. Never expose as NEXT_PUBLIC_*, never store in source control or browser storage.
# PAINTTRACK_MFA_ENCRYPTION_KEY=

# Server-side provider credential (stage 4.5.2). Server processes only.
# Never expose as NEXT_PUBLIC_*, never read from browser cookies or localStorage.
# Leave both unset to keep generation fail-closed: pages must report "provider not configured".
# PAINTTRACK_PROVIDER_NAME=muapi
# PAINTTRACK_PROVIDER_CREDENTIAL=

# Worker provider selection (stage 5.3). Only the worker process reads it.
# Unset => the worker refuses to start (tasks stay queued) instead of failing user tasks.
# mock => in-memory placeholder results, used for local end-to-end runs; refused when NODE_ENV=production.
# PAINTTRACK_WORKER_PROVIDER=mock
# PAINTTRACK_WORKER_ID=worker-local-1

# First real async image adapter (server-side only; loopback mock for local protocol tests).
# Use this mode only after the provider credential and endpoint have been configured.
# PAINTTRACK_WORKER_PROVIDER=myvigna-image
# PAINTTRACK_PROVIDER_NAME=myvigna
# PAINTTRACK_PROVIDER_CREDENTIAL=
# PAINTTRACK_PROVIDER_BASE_URL=https://www.myvigna.top/v1
# PAINTTRACK_PROVIDER_MODEL=gpt-image-2
