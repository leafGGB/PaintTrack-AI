        "assets_media_type_check": {
          "name": "assets_media_type_check",
          "value": "\"assets\".\"media_type\" IN ('image', 'video', 'audio', 'document')"
        },
        "assets_size_bytes_check": {
          "name": "assets_size_bytes_check",
          "value": "\"assets\".\"size_bytes\" IS NULL OR \"assets\".\"size_bytes\" >= 0"
        },
        "assets_status_check": {
          "name": "assets_status_check",
          "value": "\"assets\".\"status\" IN ('pending', 'uploading', 'ready', 'failed', 'deleted')"
        },
        "assets_status_storage_consistency_check": {
          "name": "assets_status_storage_consistency_check",
          "value": "(\"assets\".\"status\" IN ('pending', 'uploading', 'failed') AND \"assets\".\"storage_key\" IS NULL) OR (\"assets\".\"status\" IN ('ready', 'deleted') AND \"assets\".\"storage_key\" IS NOT NULL)"
        },
        "assets_deleted_at_consistency_check": {
          "name": "assets_deleted_at_consistency_check",
          "value": "(\"assets\".\"status\" = 'deleted' AND \"assets\".\"deleted_at\" IS NOT NULL) OR (\"assets\".\"status\" <> 'deleted' AND \"assets\".\"deleted_at\" IS NULL)"
        },
        "assets_checksum_sha256_format_check": {
          "name": "assets_checksum_sha256_format_check",
          "value": "\"assets\".\"checksum_sha256\" IS NULL OR \"assets\".\"checksum_sha256\" ~ '^[0-9a-f]{64}$'"
        }
